# Copiar a .env antes de levantar (opcional: sin .env se usan estos mismos valores).
# Valores de ejemplo para uso local. No contienen secretos reales.

# Django
DJANGO_SECRET_KEY=cambiar-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes confiables para CSRF (agregar el puerto si se cambia APP_PORT)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# En producción con HTTPS: true
SECURE_COOKIES=false

# URL pública de la aplicación, usada en los enlaces de los correos
APP_URL=http://localhost

# Puertos publicados en la máquina local
APP_PORT=80
MAILPIT_PORT=8025

# PostgreSQL: superusuario (solo lo usa el contenedor db al crear los roles)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
DB_NAME=sigs
# Rol dueño: migra y carga los datos de demo (no es superusuario)
DB_OWNER_USER=sigs_owner
DB_OWNER_PASSWORD=sigs_owner
# Rol de la aplicación: lo usa el servidor web. En la auditoría solo puede leer e insertar
DB_APP_USER=sigs_app
DB_APP_PASSWORD=sigs_app

# Carga automática de datos ficticios al iniciar (solo si la base está vacía)
CARGAR_DATOS_DEMO=true
